# ── MongoDB ────────────────────────────────────────────────────
# Get from https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/quotesphere?retryWrites=true&w=majority

# ── NextAuth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars

# Your deployed URL (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth (optional) ────────────────────────────────────
# Create at https://console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (for image uploads) ────────────────────────────
# Get from https://cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Exchange Rate API ──────────────────────────────────────────
# Get from https://www.exchangerate-api.com
EXCHANGERATE_API_KEY=

# ── PDF generation (headless Chrome) ──────────────────────────
# Absolute base URL the PDF route tells Chromium to open for /print/* .
# Defaults to NEXTAUTH_URL / https://$VERCEL_URL. Set explicitly for custom domains.
PDF_BASE_URL=http://localhost:3000
# Production ONLY (Vercel): pinned @sparticuz/chromium release pack (matches
# @sparticuz/chromium-min@149). Host it yourself (Vercel Blob) for reliability,
# or use the GitHub release tar:
# https://github.com/Sparticuz/chromium/releases/download/v149.0.0/chromium-v149.0.0-pack.x64.tar
CHROMIUM_PACK_URL=
# Local dev ONLY (optional): path to a Chrome/Chromium binary if `channel:"chrome"`
# can't find one. e.g. /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# PUPPETEER_EXECUTABLE_PATH=

# ── AI Assistant ───────────────────────────────────────────────
# Powers /assistant (create & edit quotations/invoices by chatting).
# Provider + model are configured per user in Settings → Integrations → AI
# Assistant; these env vars are the fallback when the API key field is left blank.
# Default model id when not set in Settings (OpenAI: gpt-4o, Anthropic: claude-sonnet-4-6).
ASSISTANT_MODEL=
# OpenAI
OPENAI_API_KEY=
# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=
# Use a Responses-API-capable version for gpt-5 / newer models.
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Anthropic
ANTHROPIC_API_KEY=

# ── Cron jobs (Vercel) ─────────────────────────────────────────
# Protects the scheduled endpoints /api/cron/recurring-invoices and
# /api/cron/reminders. Set this in the Vercel dashboard (Project → Settings →
# Environment Variables); Vercel auto-sends "Authorization: Bearer <CRON_SECRET>"
# on each cron run and the routes verify it. Optional locally — crons don't run
# on your machine, and without it the endpoints stay open for manual testing.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────
# Powers invoice/quotation emails, payment receipts, and automated payment
# reminders. Get a key at https://resend.com → API Keys. Without it, all email
# sending is silently skipped and the Reminders "Email" channel stays disabled.
RESEND_API_KEY=
# "From" address — must use a domain you've verified in Resend (or
# onboarding@resend.dev for quick testing).
RESEND_FROM="QuoteSphere <no-reply@yourdomain.com>"
# Deliverability: in Resend → Domains, add your domain and create the SPF, DKIM
# and DMARC DNS records it shows you — without them, emails land in spam.
